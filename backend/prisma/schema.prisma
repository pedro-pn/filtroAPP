// Título a pagar do Omie = gasto realizado vinculado a um projeto.
model OmiePurchase {
  id                    String    @id @default(cuid())
  omieId                String    @unique // codigo_lancamento_omie
  codigoProjeto         String? // codigo interno do Omie
  projectId             String?
  osNumber              String?
  valor                 Decimal?  @db.Decimal(14, 2) // valor_documento
  statusTitulo          String? // PAGO, ABERTO, ...
  categoriaCodigo       String?
  categoriaDescricao    String?
  fornecedorCodigo      String?
  numeroDocumento       String?
  numeroDocumentoFiscal String?
  origem                String? // id_origem (APIP, etc.)
  dataEmissao           DateTime?
  dataVencimento        DateTime?
  dataPrevisao          DateTime?
  linkStatus            String    @default("LINKED") // LINKED | UNMATCHED
  rawPayload            Json
  syncedAt              DateTime  @default(now())
  project               Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([codigoProjeto])
  @@index([categoriaCodigo])
  @@index([statusTitulo])
}

// Título a receber do Omie = faturamento/receita real vinculada a um projeto.
model OmieReceivable {
  id                    String    @id @default(cuid())
  omieId                String    @unique // codigo_lancamento_omie
  codigoProjeto         String? // codigo interno do Omie
  projectId             String?
  osNumber              String?
  valor                 Decimal?  @db.Decimal(14, 2) // valor_documento
  valorIss              Decimal?  @db.Decimal(14, 2) // valor_iss informado na NF/conta a receber
  aliquotaIss           Decimal?  @db.Decimal(5, 2) // nAliquotaISS vindo da NFSe
  codigoLc116           String? // CodigoLC116 vindo da NFSe (ex.: 7.02, 7.05, 14.01)
  codigoServico         String? // CodigoServico municipal vindo da NFSe
  statusTitulo          String? // RECEBIDO, A RECEBER, ATRASADO, ...
  categoriaCodigo       String?
  categoriaDescricao    String?
  clienteCodigo         String?
  numeroDocumento       String?
  numeroDocumentoFiscal String?
  numeroPedido          String?
  codigoTipoDocumento   String? // NFS, etc.
  origem                String? // id_origem (VENR, etc.)
  dataEmissao           DateTime?
  dataVencimento        DateTime?
  dataPrevisao          DateTime?
  dataRegistro          DateTime?
  retemIss              Boolean?
  retemPis              Boolean?
  retemCofins           Boolean?
  retemCsll             Boolean?
  retemIr               Boolean?
  rawPayload            Json
  syncedAt              DateTime  @default(now())
  project               Project?  @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([codigoProjeto])
  @@index([codigoTipoDocumento])
  @@index([statusTitulo])
  @@index([dataEmissao])
}

// Histórico fiscal validado, separado dos títulos/parcelas de contas a receber.
// O vínculo usa o código Omie atual para acompanhar remapeamentos de projetos.
model OmieInvoice {
  id               String   @id
  source           String // NFSE | NFE
  codigoProjeto    String
  numero           String
  serie            String?
  dataEmissao      DateTime
  valor            Decimal  @db.Decimal(14, 2)
  clienteNome      String?
  clienteCnpj      String?
  receiptStatus    String // RECEIVED | PARTIAL | OVERDUE | OPEN | UNKNOWN
  installmentCount Int      @default(0)
  syncedAt         DateTime @default(now())

  @@index([codigoProjeto, dataEmissao])
}

model IntegrationSyncRun {
  id             String    @id @default(cuid())
  integration    String // 'OMIE'
  scope          String? // projects | categories | purchases | receivables | invoices
  status         String    @default("RUNNING") // RUNNING | SUCCESS | ERROR
  recordsRead    Int       @default(0)
  recordsWritten Int       @default(0)
  error          String?
  summary        Json?
  triggeredBy    String? // SCRIPT | SCHEDULE | MANUAL
  startedAt      DateTime  @default(now())
  finishedAt     DateTime?

  @@index([integration, startedAt])
  @@index([status])
}

// === Modulo Assinaturas Avulsas ===

model SignatureDocument {
  id                        String                                   @id @default(cuid())
  ownerUserId               String?
  requesterNameSnapshot     String
  title                     String
  originalFileName          String
  mimeType                  String                                   @default("application/pdf")
  fileSizeBytes             Int
  pageCount                 Int
  pageDimensions            Json
  sourceStoragePath         String?
  sourceDocumentHash        String
  finalStoragePath          String?
  finalDocumentHash         String?
  validationCode            String?                                  @unique
  status                    SignatureDocumentStatus                  @default(RASCUNHO)
  tokenExpiresAt            DateTime?
  finalizationClaimedAt     DateTime?
  finalizationAttempts      Int                                      @default(0)
  finalizationNextAttemptAt DateTime?
  finalizationLastError     String?
  cancelReason              String?
  publishedAt               DateTime?
  completedAt               DateTime?
  canceledAt                DateTime?
  archivedAt                DateTime?
  deletedAt                 DateTime?
  filesPurgedAt             DateTime?
  createdAt                 DateTime                                 @default(now())
  updatedAt                 DateTime                                 @updatedAt
  owner                     User?                                    @relation("SignatureDocumentOwner", fields: [ownerUserId], references: [id], onDelete: SetNull)
  signers                   SignatureDocumentSigner[]
  fields                    SignatureDocumentField[]
  auditLogs                 SignatureDocumentAuditLog[]
  completionNotification    SignatureDocumentCompletionNotification?

  @@index([ownerUserId, deletedAt, archivedAt, createdAt])
  @@index([ownerUserId])
  @@index([ownerUserId, status])
  @@index([status, finalizationNextAttemptAt])
  @@index([deletedAt])
  @@index([archivedAt])
}

model SignatureDocumentSigner {
  id                      String                                     @id @default(cuid())
  documentId              String
  name                    String
  email                   String?
  position                Int
  status                  SignatureDocumentSignerStatus              @default(PENDENTE)
  isRequired              Boolean                                    @default(true)
  tokenHash               String?                                    @unique
  tokenEncrypted          String?
  tokenIv                 String?
  tokenAuthTag            String?
  tokenExpiresAt          DateTime?
  renewalCount            Int                                        @default(0)
  invalidationReason      SignatureDocumentInviteInvalidationReason?
  emailStatus             SignatureDocumentEmailStatus               @default(NAO_APLICAVEL)
  emailAttempts           Int                                        @default(0)
  emailSentAt             DateTime?
  emailLastError          String?
  emailClaimedAt          DateTime?
  declaredSignerName      String?
  signatureImageDataUrl   String?
  ipAddress               String?
  userAgent               String?
  privacyNoticeAcceptedAt DateTime?
  privacyNoticeVersion    String?
  viewedAt                DateTime?
  signedAt                DateTime?
  revokedAt               DateTime?
  expiredAt               DateTime?
  createdAt               DateTime                                   @default(now())
  updatedAt               DateTime                                   @updatedAt
  document                SignatureDocument                          @relation(fields: [documentId], references: [id], onDelete: Cascade)
  fields                  SignatureDocumentField[]
  auditLogs               SignatureDocumentAuditLog[]

  @@unique([documentId, position])
  @@index([documentId])
  @@index([documentId, status])
  @@index([status, tokenExpiresAt])
  @@index([emailStatus, emailClaimedAt])
}

model SignatureDocumentField {
  id           String                  @id @default(cuid())
  documentId   String
  signerId     String
  pageNumber   Int
  x            Decimal                 @db.Decimal(9, 8)
  y            Decimal                 @db.Decimal(9, 8)
  width        Decimal                 @db.Decimal(9, 8)
  height       Decimal                 @db.Decimal(9, 8)
  pageWidthPt  Decimal                 @db.Decimal(10, 3)
  pageHeightPt Decimal                 @db.Decimal(10, 3)
  pageRotation Int                     @default(0)
  createdAt    DateTime                @default(now())
  updatedAt    DateTime                @updatedAt
  document     SignatureDocument       @relation(fields: [documentId], references: [id], onDelete: Cascade)
  signer       SignatureDocumentSigner @relation(fields: [signerId], references: [id], onDelete: Cascade)

  @@index([documentId, pageNumber])
  @@index([signerId])
}

model SignatureDocumentAuditLog {
  id          String                       @id @default(cuid())
  documentId  String
  signerId    String?
  actorUserId String?
  action      SignatureDocumentAuditAction
  description String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime                     @default(now())
  document    SignatureDocument            @relation(fields: [documentId], references: [id], onDelete: Cascade)
  signer      SignatureDocumentSigner?     @relation(fields: [signerId], references: [id], onDelete: SetNull)
  actor       User?                        @relation("SignatureDocumentAuditActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([documentId, createdAt])
  @@index([signerId])
  @@index([actorUserId])
  @@index([action])
  @@index([createdAt])
}

model SignatureDocumentFilePurge {
  id             String                           @id @default(cuid())
  operationKey   String                           @unique
  targetUserId   String
  quarantineRoot String
  manifest       Json
  status         SignatureDocumentFilePurgeStatus @default(PREPARANDO)
  attempts       Int                              @default(0)
  claimedAt      DateTime?
  nextAttemptAt  DateTime?
  lastError      String?
  completedAt    DateTime?
  createdAt      DateTime                         @default(now())
  updatedAt      DateTime                         @updatedAt

  @@index([status, nextAttemptAt])
  @@index([targetUserId])
  @@index([createdAt])
}

model SignatureDocumentCompletionNotification {
  id                String                       @id @default(cuid())
  documentId        String                       @unique
  idempotencyKey    String                       @unique
  emailTo           String
  status            SignatureDocumentEmailStatus @default(PENDENTE)
  attempts          Int                          @default(0)
  claimedAt         DateTime?
  nextAttemptAt     DateTime?
  providerMessageId String?
  lastError         String?
  sentAt            DateTime?
  createdAt         DateTime                     @default(now())
  updatedAt         DateTime                     @updatedAt
  document          SignatureDocument            @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([createdAt])
}
