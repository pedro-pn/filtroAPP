model Collaborator {
  id                             String                           @id @default(cuid())
  code                           String                           @unique
  name                           String
  jobRoleId                      String
  efetivoNote                    String?
  email                          String?
  cpf                            String?
  registrationNumber             String?
  admissionDate                  DateTime?
  terminationDate                DateTime?
  signatureImage                 String?
  signatureNoticeAcceptedAt      DateTime?
  signatureNoticeVersion         String?
  isActive                       Boolean                          @default(true)
  createdAt                      DateTime                         @default(now())
  updatedAt                      DateTime                         @updatedAt
  projectsLed                    Project[]                        @relation("ProjectOperator")
  reportLinks                    ReportCollaborator[]
  user                           User?
  epiRecords                     EpiRecord[]
  epiSignatureRequests           EpiSignatureRequest[]
  epiProfile                     EpiCollaboratorProfile?
  signatureNoticeLogs            CollaboratorSignatureNoticeLog[]
  pontoPeriods                   PontoPeriodSummary[]
  pontoNameAliases               PontoNameAlias[]
  pontoExternalLinks             PontoExternalEmployeeLink[]
  pontoDayProjectOverrides       PontoDayProjectOverride[]
  absences                       CollaboratorAbsence[]
  jobRole                        JobRole                          @relation("CollaboratorJobRole", fields: [jobRoleId], references: [id], onDelete: Restrict)
  jobRoleHistory                 CollaboratorJobRoleHistory[]
  efetivoMissionResponsibilities EfetivoMissionPlan[]             @relation("EfetivoMissionResponsible")
  efetivoMissionAllocations      EfetivoMissionAllocation[]
  maintenanceSupervisorConfigs   MaintenanceConfiguration[]       @relation("MaintenanceSupervisor")

  @@index([jobRoleId])
}

model CollaboratorJobRoleHistory {
  id             String       @id @default(cuid())
  collaboratorId String
  jobRoleId      String
  effectiveDate  DateTime     @db.Date
  note           String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  jobRole        JobRole      @relation(fields: [jobRoleId], references: [id], onDelete: Restrict)

  @@unique([collaboratorId, effectiveDate])
  @@index([collaboratorId, effectiveDate])
  @@index([jobRoleId, effectiveDate])
}

model CollaboratorSignatureNoticeLog {
  id             String       @id @default(cuid())
  collaboratorId String
  userId         String?
  noticeVersion  String
  createdAt      DateTime     @default(now())
  collaborator   Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  user           User?        @relation("CollaboratorSignatureNoticeUser", fields: [userId], references: [id], onDelete: SetNull)

  @@index([collaboratorId])
  @@index([userId])
  @@index([createdAt])
}

model ClientSegment {
  id        String   @id @default(cuid())
  label     String   @unique
  slug      String   @unique
  isActive  Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Motor de custo de colaborador: perfil + parâmetros versionados.
// Um perfil pode ser vinculado a um cargo (JobRole) — nesse caso é o custo daquele cargo.
model CostProfile {
  id            String             @id @default(cuid())
  key           String             @unique // operador, auxiliar, role:<jobRoleId>
  label         String
  jobRoleId     String?            @unique // quando setado, é o perfil de custo de um cargo
  isActive      Boolean            @default(true)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  parameterSets CostParameterSet[]
  jobRole       JobRole?           @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)
}

model CostParameterSet {
  id              String      @id @default(cuid())
  costProfileId   String
  version         Int
  effectiveDate   DateTime    @db.Date
  params          Json // campos "amarelos" da planilha (salário, %s, benefícios, FGTS, multa)
  note            String?
  createdByUserId String?
  createdAt       DateTime    @default(now())
  profile         CostProfile @relation(fields: [costProfileId], references: [id], onDelete: Cascade)

  @@unique([costProfileId, version])
  @@index([costProfileId])
  @@index([costProfileId, effectiveDate])
}

// Configurações globais do módulo Acompanhamento (chave/valor). Ex.: custo de EPI por colaborador.
model AcompanhamentoSetting {
  key             String   @id
  numberValue     Float?
  updatedByUserId String?
  updatedAt       DateTime @default(now()) @updatedAt
}

model EfetivoSetting {
  key             String   @id
  numberValue     Float?
  updatedByUserId String?
  updatedAt       DateTime @default(now()) @updatedAt
}

model CollaboratorAbsence {
  id              String                  @id @default(cuid())
  collaboratorId  String
  type            CollaboratorAbsenceType @default(FERIAS)
  startDate       DateTime                @db.Date
  endDate         DateTime                @db.Date
  note            String?
  createdByUserId String?
  updatedByUserId String?
  version         Int                     @default(1)
  deletedAt       DateTime?
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  collaborator    Collaborator            @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)

  @@index([collaboratorId, startDate])
  @@index([collaboratorId, deletedAt, startDate, endDate])
  @@index([type, startDate])
  @@index([deletedAt])
}

// === Ponto (jornada) do VR Ponto Mais — base do custo de mão de obra (HH) ===
// A API é a origem principal quando configurada; XLSX históricos e de contingência permanecem
// compatíveis. Cada snapshot guarda auditoria + um resumo por colaborador no período.

model PontoImport {
  id                   String               @id @default(cuid())
  fileName             String
  contentHash          String // sha256 hex do arquivo (idempotência)
  source               String               @default("XLSX")
  periodStart          DateTime             @db.Date
  periodEnd            DateTime             @db.Date
  rowsRead             Int                  @default(0)
  collaboratorsTotal   Int                  @default(0)
  collaboratorsMatched Int                  @default(0)
  summary              Json?
  status               String               @default("OK")
  importedByUserId     String?
  createdAt            DateTime             @default(now())
  periods              PontoPeriodSummary[]
  syncRuns             PontoSyncRun[]

  @@index([createdAt])
  @@index([contentHash])
}

// Resumo por colaborador × snapshot: horas normais, HE70/HE100 explícitas quando disponíveis,
// dias trabalhados e etiquetas diárias para conciliação com os RDOs.
model PontoPeriodSummary {
  id                 String        @id @default(cuid())
  importId           String
  collaboratorId     String? // null até o nome ser vinculado a um Collaborator
  sourceKey          String?
  externalEmployeeId String?
  registrationNumber String?
  rawName            String
  normalizedName     String
  periodStart        DateTime      @db.Date
  periodEnd          DateTime      @db.Date
  workedMinutes      Int           @default(0)
  he70Minutes        Int           @default(0)
  he100Minutes       Int           @default(0)
  nightMinutes       Int           @default(0)
  workedDates        String[]      @default([]) // ["YYYY-MM-DD", ...] dias com horas normais > 0
  monthly            Json? // { "YYYY-MM": { normalMinutes, extrasMinutes, nightMinutes, workedDates[] } }
  createdAt          DateTime      @default(now())
  import             PontoImport   @relation(fields: [importId], references: [id], onDelete: Cascade)
  collaborator       Collaborator? @relation(fields: [collaboratorId], references: [id], onDelete: SetNull)

  @@unique([importId, sourceKey])
  @@index([collaboratorId])
  @@index([importId])
}

// Lembra vínculos manuais nome-do-ponto → colaborador (variações de caixa/apelido entre imports).
model PontoNameAlias {
  id              String       @id @default(cuid())
  normalizedName  String       @unique
  rawName         String
  collaboratorId  String
  createdByUserId String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  collaborator    Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)

  @@index([collaboratorId])
}

// Auditoria separada das tentativas de sincronização. Falhas não entram no escopo financeiro.
model PontoSyncRun {
  id                   String       @id @default(cuid())
  periodStart          DateTime     @db.Date
  periodEnd            DateTime     @db.Date
  status               String       @default("RUNNING")
  trigger              String       @default("MANUAL")
  requestedByUserId    String?
  importId             String?
  employeesRead        Int          @default(0)
  workDaysRead         Int          @default(0)
  timeCardsRead        Int          @default(0)
  collaboratorsMatched Int          @default(0)
  pendingCount         Int          @default(0)
  summary              Json?
  errorCode            String?
  errorMessage         String?
  startedAt            DateTime     @default(now())
  completedAt          DateTime?
  import               PontoImport? @relation(fields: [importId], references: [id], onDelete: SetNull)

  @@index([status, startedAt])
  @@index([importId])
}

// Cursor persistente da carga histórica e da atualização diária do Ponto Mais.
// A aplicação usa uma única linha com id="pontomais".
model PontoSyncState {
  id                 String    @id
  bootstrapStatus    String    @default("PENDING")
  dataRevision       Int       @default(1)
  targetDataRevision Int?
  historyStart       DateTime? @db.Date
  historyThrough     DateTime? @db.Date
  nextPeriodStart    DateTime? @db.Date
  lastDailySyncDate  DateTime? @db.Date
  lastAttemptAt      DateTime?
  lastSuccessfulAt   DateTime?
  lastErrorCode      String?
  lastErrorMessage   String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([bootstrapStatus, updatedAt])
}

// Vínculo persistente pelo identificador estável do colaborador no Ponto Mais.
model PontoExternalEmployeeLink {
  id                 String       @id @default(cuid())
  externalEmployeeId String       @unique
  registrationNumber String?
  externalName       String
  collaboratorId     String
  matchSource        String       @default("MANUAL")
  createdByUserId    String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  collaborator       Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Restrict)

  @@index([collaboratorId])
}

// Diretório dos colaboradores descobertos na API. Permite excluir pessoas fora da operação
// sem apagar a trilha histórica nem impedir que a preferência seja revertida pelo gestor.
model PontoExternalEmployee {
  externalEmployeeId String    @id
  registrationNumber String?
  externalName       String
  isActive           Boolean?
  ignoredAt          DateTime?
  ignoredByUserId    String?
  firstSeenAt        DateTime  @default(now())
  lastSeenAt         DateTime  @default(now())
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([ignoredAt, externalName])
}

// Alias de etiqueta livre do Ponto Mais para projeto interno.
model PontoProjectTagAlias {
  id              String   @id @default(cuid())
  normalizedTag   String   @unique
  rawTag          String
  projectId       String
  createdByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@index([projectId])
}

// Etiqueta do Ponto Mais que o gestor decidiu não cadastrar como projeto. Sai das pendências e da
// contagem sem apagar a trilha: basta remover a linha para voltar a cobrar o cadastro.
model PontoIgnoredProjectTag {
  normalizedTag   String   @id
  rawTag          String
  ignoredByUserId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([createdAt])
}

// Seleção gerencial para um conflito de projeto em um colaborador/data específico.
// A escolha não altera o snapshot original e apenas substitui a regra automática no cálculo.
model PontoDayProjectOverride {
  id                 String       @id @default(cuid())
  collaboratorId     String
  workDate           DateTime     @db.Date
  projectId          String
  externalEmployeeId String?
  createdByUserId    String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  collaborator       Collaborator @relation(fields: [collaboratorId], references: [id], onDelete: Cascade)
  project            Project      @relation(fields: [projectId], references: [id], onDelete: Restrict)

  @@unique([collaboratorId, workDate, projectId])
  @@index([collaboratorId, workDate])
  @@index([projectId])
  @@index([externalEmployeeId, workDate])
}

// Lista gerenciável de cargos (substitui o texto livre em Collaborator.role).
model JobRole {
  id                          String                       @id @default(cuid())
  name                        String                       @unique
  normalizedKey               String                       @unique
  order                       Int                          @default(0)
  isActive                    Boolean                      @default(true)
  isOperational               Boolean                      @default(true)
  calendarColor               String                       @default("#64748B")
  continuousWorkLimitDays     Int?
  createdAt                   DateTime                     @default(now())
  updatedAt                   DateTime                     @updatedAt
  plannedNormalHours          ProjectPlannedNormalHours[]
  plannedOvertime             ProjectPlannedOvertime[]
  costProfile                 CostProfile?
  collaborators               Collaborator[]               @relation("CollaboratorJobRole")
  collaboratorHistory         CollaboratorJobRoleHistory[]
  efetivoMissionDemands       EfetivoMissionDemand[]
  efetivoMissionAllocations   EfetivoMissionAllocation[]
  efetivoPlannedHires         EfetivoPlannedHire[]
  epiProfiles                 EpiCollaboratorProfile[]     @relation("EpiRoleOverride")
  epiSignatureSnapshots       EpiSignatureRequest[]        @relation("EpiSignatureJobRoleSnapshot")
  reportCollaboratorSnapshots ReportCollaborator[]         @relation("ReportCollaboratorJobRoleSnapshot")

  @@index([isActive, order])
}

// Lista gerenciável de temas de DDS abordados nos RDOs (gestores e coordenadores).
model DdsTheme {
  id        String   @id @default(cuid())
  name      String   @unique
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, order])
}

model Project {
  id                             String    @id @default(cuid())
  code                           String    @unique
  name                           String
  isActive                       Boolean   @default(true)
  visibleToCollaborators         Boolean   @default(true)
  managerOnly                    Boolean   @default(false)
  registrationPending            Boolean   @default(false)
  inhibitionServiceEnabled       Boolean   @default(false)
  requireServiceReportSignatures Boolean   @default(false)
  offshore                       Boolean   @default(false) // projeto offshore: +transferência no custo de MO
  laborSleepModeByCollaborator   Json      @default("{}") // Acompanhamento: collaboratorId -> HOME/AWAY para RDO não-offshore
  laborCollaboratorIds           Json      @default("[]") // Acompanhamento: colaboradores adicionados manualmente ao cronograma
  acompanhamentoArchivedAt       DateTime? // arquivamento exclusivo do módulo Acompanhamento
  acompanhamentoReviewedAt       DateTime? // última conferência enquanto arquivado no Acompanhamento
  acompanhamentoReportArchivedAt DateTime? // última finalização originada no módulo Relatórios

  clientName                 String
  clientCnpj                 String
  clientEmailPrimary         String                             @default("")
  clientSignerFirstName      String                             @default("")
  clientSignerLastName       String                             @default("")
  clientEmailCc              String[]                           @default([])
  clientSigners              Json[]                             @default([])
  contractCode               String
  location                   String
  workdayHours               String                             @default("09:00")
  weekendWorkdayHours        String                             @default("08:00")
  includesSaturday           Boolean                            @default(false)
  includesSunday             Boolean                            @default(false)
  operatorId                 String?
  clientSegment              String?
  commercialProposalCode     String? // = cod_prop do Access; reconciliação proposta↔projeto
  mobilizationDate           DateTime? // data de mobilização (manual, gestor/coordenador)
  demobilizationDate         DateTime? // data de desmobilização (manual); fecha a janela de alocação
  startDate                  DateTime? // início real da execução (manual, gestor/coordenador)
  manualProgressPct          Decimal?                           @db.Decimal(5, 2) // avanço informado à mão (fallback quando não há escopo)
  createdAt                  DateTime                           @default(now())
  updatedAt                  DateTime                           @updatedAt
  deletedAt                  DateTime?
  operator                   Collaborator?                      @relation("ProjectOperator", fields: [operatorId], references: [id], onDelete: SetNull)
  reportSequences            ProjectReportSeq[]
  authorizedUsers            ProjectAuthorizedUser[]
  reports                    Report[]
  drafts                     ReportDraft[]
  surveys                    SatisfactionSurvey[]
  romaneios                  Romaneio[]
  budgets                    ProjectBudget[]
  omieProjects               OmieProject[]
  omiePurchases              OmiePurchase[]
  omieReceivables            OmieReceivable[]
  plannedServices            ProjectPlannedService[]
  plannedNormalHours         ProjectPlannedNormalHours[]
  plannedOvertime            ProjectPlannedOvertime[]
  stockMovements             StockMovement[]
  manualProgressHistory      ProjectManualProgressHistory[]
  manualCosts                ProjectManualCost[]
  managementNotes            ProjectManagementNote[]
  additionalProposals        ProjectAdditionalProposal[]
  acompanhamentoGroupMembers AcompanhamentoMissionGroupMember[]
  primaryLaborMissionGroups  AcompanhamentoMissionGroup[]       @relation("AcompanhamentoMissionGroupPrimaryLaborProject")
  qualityRecords             QualityRecord[]
