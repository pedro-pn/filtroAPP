  isActive                Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  calibrationCertificates CalibrationCertificate[]
}

model ParticleCounter {
  id                      String                   @id @default(cuid())
  code                    String                   @unique
  serialNumber            String
  category                String                   @default("CONTADOR DE PARTICULAS")
  calibratedAt            DateTime
  expiresAt               DateTime
  isActive                Boolean                  @default(true)
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  calibrationCertificates CalibrationCertificate[]

  @@index([category])
}

enum CalibrationEquipmentType {
  MANOMETER
  PARTICLE_COUNTER
}

model CalibrationCertificate {
  id                String                   @id @default(cuid())
  equipmentType     CalibrationEquipmentType
  fileName          String
  mimeType          String                   @default("application/pdf")
  storagePath       String
  publicToken       String                   @unique
  manometerId       String?
  particleCounterId String?
  manometer         Manometer?               @relation(fields: [manometerId], references: [id], onDelete: Cascade)
  particleCounter   ParticleCounter?         @relation(fields: [particleCounterId], references: [id], onDelete: Cascade)
  createdAt         DateTime                 @default(now())

  @@index([manometerId, createdAt])
  @@index([particleCounterId, createdAt])
}

model CalibrationNotificationLog {
  id            String   @id @default(cuid())
  equipmentType String
  equipmentId   String
  category      String
  milestone     String
  targetDate    DateTime
  sentAt        DateTime @default(now())

  @@unique([equipmentType, equipmentId, milestone, targetDate])
  @@index([category, milestone, sentAt])
}

// === Módulo Equipamentos ===

model EquipmentCategory {
  id                      String              @id @default(cuid())
  systemKey               String              @unique // slug imutável usado pelo RDO/romaneio
  name                    String // rótulo editável (vira a aba)
  maintenanceProfileId    String?
  maintenanceIntervalDays Int?
  showInMaintenance       Boolean             @default(true)
  order                   Int                 @default(0)
  fieldSchema             Json                @default("[]") // [{ key, label, type, required, options?, order, showInDashboard? }]
  technicalSchema         Json                @default("[]") // dados técnicos: [{ key, label, type, group?, unit?, options?, repeatable?, itemSchema?, optionalPerEquipment?, showInDoc?, order }]
  checklistEnabled        Boolean             @default(false)
  checklistItems          Json                @default("[]") // pontos de checagem herdados pelos equipamentos da categoria
  checklistDisplayMode    String              @default("AUTO") // AUTO | TAG | NAME para <<nomeoutag>>
  technicalDocEnabled     Boolean             @default(false) // liga a aba "Dados Técnicos" (datasheet estruturado + geração DOCX→PDF)
  technicalTemplateId     String? // DOCX modelo da categoria (Etapa F); null = usa o modelo genérico
  supportsCalibration     Boolean             @default(false)
  supportsTechnicalDoc    Boolean             @default(true) // anexo PDF legado (mantido como histórico)
  syncToRomaneio          Boolean             @default(false)
  isSystemManaged         Boolean             @default(false) // categorias consumidas pelo RDO (não removíveis)
  isActive                Boolean             @default(true)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  maintenanceProfile      MaintenanceProfile? @relation("CategoryMaintenanceProfile", fields: [maintenanceProfileId], references: [id], onDelete: SetNull)
  equipment               CompanyEquipment[]

  @@index([maintenanceProfileId])
}

model CompanyEquipment {
  id                         String                @id @default(cuid())
  code                       String                @unique
  name                       String
  categoryId                 String
  maintenanceProfileId       String?
  maintenanceProfileOverride Boolean               @default(false)
  attributes                 Json                  @default("{}") // valores dos campos dinâmicos, keyed por field.key
  technicalData              Json                  @default("{}") // valores do datasheet, keyed por technicalSchema.key
  technicalFieldOverrides    Json                  @default("{}") // inclusão/exclusão de campos optionalPerEquipment, keyed por key -> bool
  checklistItems             Json? // null = herda da categoria; array = override integral
  technicalRevision          Int                   @default(0)
  technicalUpdatedAt         DateTime?
  hasCalibration             Boolean               @default(false)
  calibratedAt               DateTime?
  expiresAt                  DateTime?
  hasTechnicalDoc            Boolean               @default(false)
  isActive                   Boolean               @default(true)
  createdAt                  DateTime              @default(now())
  updatedAt                  DateTime              @updatedAt
  category                   EquipmentCategory     @relation(fields: [categoryId], references: [id])
  maintenanceProfile         MaintenanceProfile?   @relation("EquipmentMaintenanceProfile", fields: [maintenanceProfileId], references: [id], onDelete: SetNull)
  attachments                EquipmentAttachment[]
  maintenanceRecords         MaintenanceRecord[]

  @@index([categoryId])
  @@index([maintenanceProfileId])
  @@index([expiresAt])
}

enum EquipmentAttachmentKind {
  CALIBRATION_CERTIFICATE
  TECHNICAL_DOC
  TECHNICAL_TEMPLATE
  TECHNICAL_DOC_GENERATED
  TECHNICAL_PHOTO
}

// Destinatários das notificações de calibração do módulo Equipamentos: contas
// internas (userId) ou e-mails avulsos. Substitui a lista fixa de gestores/coordenadores.
model EquipmentNotificationRecipient {
  id        String   @id @default(cuid())
  userId    String?
  email     String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Configuração (singleton) dos e-mails de calibração: marcos, repetição e on/off.
model EquipmentNotificationConfig {
  id             String   @id @default(cuid())
  enabled        Boolean  @default(true)
  milestoneDays  Int[]    @default([30, 15, 7])
  notifyOnDueDay Boolean  @default(true)
  repeatExpired  Boolean  @default(true)
  repeatGapDays  Int      @default(5)
  updatedAt      DateTime @updatedAt
}

// Mapeamento configurável: cada "slot" de equipamento do formulário de RDO
// (definido no catálogo de código) aponta para uma categoria de equipamento.
model RdoEquipmentSlot {
  id          String   @id @default(cuid())
  slotKey     String   @unique
  categoryId  String? // legado (1 categoria) — mantido como fallback
  categoryIds Json     @default("[]") // múltiplas categorias por slot
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([categoryId])
}

model EquipmentAttachment {
  id          String                  @id @default(cuid())
  equipmentId String
  kind        EquipmentAttachmentKind
  fileName    String
  mimeType    String                  @default("application/pdf")
  storagePath String
  publicToken String                  @unique
  createdAt   DateTime                @default(now())
  equipment   CompanyEquipment        @relation(fields: [equipmentId], references: [id], onDelete: Cascade)

  @@index([equipmentId, kind, createdAt])
}

// === Modulo Estoque ===

model StockItem {
  id               String              @id @default(cuid())
  type             StockItemType
  categoryId       String?
  code             String              @unique
  name             String
  manufacturer     String?
  description      String?
  unitLabel        String
  minQuantity      Decimal?            @db.Decimal(12, 3)
  location         String?
  filterModel      String?
  filterKind       String?
  filterMicron     String?
  unNumber         String?
  casNumber        String?
  checklistEnabled Boolean             @default(false)
  checklistItems   Json?
  isActive         Boolean             @default(true)
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  category         StockCategory?      @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  batches          StockBatch[]
  movements        StockMovement[]
  documents        StockItemDocument[]

  @@index([categoryId])
}

model StockItemDocument {
  id          String    @id @default(cuid())
  itemId      String
  fileName    String
  mimeType    String    @default("application/pdf")
  storagePath String?
  publicToken String    @unique
  createdAt   DateTime  @default(now())
  item        StockItem @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId, createdAt])
}

model StockCategory {
  id               String        @id @default(cuid())
  type             StockItemType
  name             String
  checklistEnabled Boolean       @default(false)
  checklistItems   Json          @default("[]")
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  items            StockItem[]

  @@unique([type, name])
  @@index([type, isActive, name])
}

model StockBatch {
  id         String          @id @default(cuid())
  itemId     String
  lotNumber  String
  expiryDate DateTime?
  nfNumber   String?
  supplier   String?
  createdAt  DateTime        @default(now())
  item       StockItem       @relation(fields: [itemId], references: [id], onDelete: Restrict)
  movements  StockMovement[]

  @@unique([itemId, lotNumber])
  @@index([expiryDate])
}

model StockMovement {
  id                     String              @id @default(cuid())
  itemId                 String
  batchId                String
  romaneioId             String?
  type                   StockMovementType
  reason                 StockMovementReason
  quantity               Decimal             @db.Decimal(12, 3)
  date                   DateTime
  projectId              String?
  nfNumber               String?
  supplier               String?
  unitCost               Decimal?            @db.Decimal(12, 2)
  requestedBy            String?
  notes                  String?
  nfAttachmentToken      String?
  excludeFromProjectCost Boolean             @default(false)
  reversalOfId           String?             @unique
  createdById            String
  createdAt              DateTime            @default(now())
  item                   StockItem           @relation(fields: [itemId], references: [id], onDelete: Restrict)
  batch                  StockBatch          @relation(fields: [batchId], references: [id], onDelete: Restrict)
  project                Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  romaneio               Romaneio?           @relation(fields: [romaneioId], references: [id], onDelete: SetNull)
  createdBy              User                @relation("StockMovementCreator", fields: [createdById], references: [id], onDelete: Restrict)
  reversalOf             StockMovement?      @relation("StockMovementReversal", fields: [reversalOfId], references: [id], onDelete: Restrict)
  reversedBy             StockMovement?      @relation("StockMovementReversal")

  @@index([itemId, date])
  @@index([batchId])
  @@index([projectId])
  @@index([romaneioId])
  @@index([type])
}

model User {
  id                                   String                              @id @default(cuid())
  username                             String                              @unique
  name                                 String
  email                                String?
  emailVerifiedAt                      DateTime?
  passwordHash                         String
  role                                 UserRole
  accountType                          AccountType                         @default(INTERNAL)
  reportEmissionPermissions            ReportEmissionPermission[]          @default([])
  isActive                             Boolean                             @default(true)
  clientCnpj                           String?
  privacyPolicyAcceptedAt              DateTime?
  privacyPolicyVersion                 String?
  notifyReportsByEmail                 Boolean                             @default(true)
  notifySignaturesByEmail              Boolean                             @default(true)
  notifySignatureRemindersByEmail      Boolean                             @default(true)
  notifySurveyRemindersByEmail         Boolean                             @default(true)
  notifyCalibrationRemindersByEmail    Boolean                             @default(true)
  collaboratorId                       String?                             @unique
  createdAt                            DateTime                            @default(now())
  updatedAt                            DateTime                            @updatedAt
  collaborator                         Collaborator?                       @relation(fields: [collaboratorId], references: [id], onDelete: SetNull)
  moduleRoles                          ModuleRole[]
  sessions                             UserSession[]
  passwordResetTokens                  PasswordResetToken[]
  emailChangeTokens                    EmailChangeToken[]
  drafts                               ReportDraft[]
  authorizedProjects                   ProjectAuthorizedUser[]
  createdReports                       Report[]                            @relation("ReportCreator")
  reviewedReports                      Report[]                            @relation("ReportReviewer")
  clientReportReviews                  ClientReportReview[]                @relation("ClientReportReviewer")
  reportVersions                       ReportVersion[]                     @relation("ReportVersionCreator")
  reportSignatures                     ReportSignature[]                   @relation("ReportSignatureUser")
  reportAuditLogs                      ReportAuditLog[]                    @relation("ReportAuditLogUser")
  collaboratorSignatureNoticeLogs      CollaboratorSignatureNoticeLog[]    @relation("CollaboratorSignatureNoticeUser")
  sentSurveys                          SatisfactionSurvey[]
  createdRomaneios                     Romaneio[]                          @relation("RomaneioCreator")
  createdEpiRecords                    EpiRecord[]                         @relation("EpiRecordCreator")
  epiSignatureRequests                 EpiSignatureRequest[]               @relation("EpiSignatureRequester")
  dataSubjectRequests                  DataSubjectRequest[]                @relation("DataSubjectRequestUser")
  completedDataSubjectRequests         DataSubjectRequest[]                @relation("DataSubjectRequestCompletedByUser")
  identityVerifiedDataSubjectRequests  DataSubjectRequest[]                @relation("DataSubjectRequestIdentityVerifiedByUser")
  dataSubjectResponseAttempts          DataSubjectRequestResponseAttempt[] @relation("DataSubjectRequestResponseAttemptUser")
  notificationPreferenceTokens         NotificationPreferenceToken[]
  accessImports                        AccessImport[]                      @relation("AccessImportUser")
  selectedBudgets                      ProjectBudget[]                     @relation("ProjectBudgetSelectedBy")
  selectedProjectAdditionalProposals   ProjectAdditionalProposal[]         @relation("ProjectAdditionalProposalSelectedBy")
  stockMovements                       StockMovement[]                     @relation("StockMovementCreator")
  projectManualCosts                   ProjectManualCost[]                 @relation("ProjectManualCostCreator")
  projectManagementNotes               ProjectManagementNote[]             @relation("ProjectManagementNoteCreator")
  createdAcompanhamentoMissionGroups   AcompanhamentoMissionGroup[]        @relation("AcompanhamentoMissionGroupCreatedBy")
  dissolvedAcompanhamentoMissionGroups AcompanhamentoMissionGroup[]        @relation("AcompanhamentoMissionGroupDissolvedBy")
  createdQualityRecords                QualityRecord[]                     @relation("QualityRecordCreator")
  updatedQualityRecords                QualityRecord[]                     @relation("QualityRecordUpdater")
  deletedQualityRecords                QualityRecord[]                     @relation("QualityRecordDeletedBy")
  responsibleEfetivoMissions           EfetivoMissionPlan[]                @relation("EfetivoMissionResponsibleUser")
  signatureDocuments                   SignatureDocument[]                 @relation("SignatureDocumentOwner")
  signatureDocumentAuditLogs           SignatureDocumentAuditLog[]         @relation("SignatureDocumentAuditActor")
  maintenanceRecordsCreated            MaintenanceRecord[]                 @relation("MaintenanceCreator")
  maintenanceRecordsReviewed           MaintenanceRecord[]                 @relation("MaintenanceReviewer")
  maintenanceConfigurationUpdates      MaintenanceConfiguration[]          @relation("MaintenanceConfigurationUpdater")
  operationalReviewAudits              OperationalReviewAudit[]            @relation("OperationalReviewAuditActor")
  apiCredentialsCreated                ApiCredential[]                     @relation("ApiCredentialCreatedBy")
  apiCredentialsRevoked                ApiCredential[]                     @relation("ApiCredentialRevokedBy")
  apiCredentialScopesGranted           ApiCredentialScope[]                @relation("ApiCredentialScopeGrantedBy")
  apiCredentialScopesRevoked           ApiCredentialScope[]                @relation("ApiCredentialScopeRevokedBy")
  apiCredentialProjectsGranted         ApiCredentialProject[]              @relation("ApiCredentialProjectGrantedBy")
  apiCredentialProjectsRevoked         ApiCredentialProject[]              @relation("ApiCredentialProjectRevokedBy")
  apiCredentialEvents                  ApiCredentialEvent[]                @relation("ApiCredentialEventActor")

  @@index([clientCnpj])
}

// === Modulo Qualidade ===

model QualityNature {
  id        String          @id @default(cuid())
  name      String
  isActive  Boolean         @default(true)
  position  Int             @default(0)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
  records   QualityRecord[]

  @@index([isActive, position, name])
  @@index([position])
}

model QualityRecord {
  id                 String              @id @default(cuid())
  number             String              @unique
  type               QualityRecordType
  seq                Int
  year               Int
  registeredAt       DateTime
  origin             String?
  projectId          String?
  eventDate          DateTime
  natureId           String?
  description        String?
  impact             QualityImpact?
  linkedRnc          String?
  disposition        QualityDisposition?
  definedAction      String?
  actionOwner        String?
  actionDeadline     DateTime?
  evidence           String?
  resultVerification String?
  status             QualityStatus?
  createdById        String?
  updatedById        String?
  deletedById        String?
  deletedAt          DateTime?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  project            Project?            @relation(fields: [projectId], references: [id], onDelete: SetNull)
  nature             QualityNature?      @relation(fields: [natureId], references: [id], onDelete: Restrict)
  createdBy          User?               @relation("QualityRecordCreator", fields: [createdById], references: [id], onDelete: SetNull)
  updatedBy          User?               @relation("QualityRecordUpdater", fields: [updatedById], references: [id], onDelete: SetNull)
  deletedBy          User?               @relation("QualityRecordDeletedBy", fields: [deletedById], references: [id], onDelete: SetNull)
  evidences          QualityEvidence[]

  @@unique([type, year, seq])
  @@index([projectId, type])
  @@index([natureId, eventDate])
  @@index([status])
  @@index([impact])
  @@index([registeredAt])
  @@index([createdById])
  @@index([updatedById])
  @@index([deletedAt])
  @@index([deletedById])
  @@index([updatedAt, id])
  @@index([deletedAt, updatedAt, id])
}

// === Credenciais da API de integrações ===

model ApiCredential {
  id                      String                 @id @default(cuid())
  selector                String                 @unique
  secretVerifier          String
  hashKeyVersion          Int
  secretLastFour          String
  name                    String
  purpose                 String
  recipientName           String
  recipientContact        String?
  description             String?
  startsAt                DateTime
  expiresAt               DateTime?
  neverExpiresConfirmedAt DateTime?
  projectAccessMode       ApiProjectAccessMode
  allowedIpCidrs          String[]               @default([])
  allowedFormats          String[]               @default(["JSON"])
  requestsPerMinute       Int                    @default(60)
  requestsPerDay          Int                    @default(10000)
  rowsPerDay              Int                    @default(500000)
  maxPageSize             Int                    @default(100)
  lastUsedAt              DateTime?
  revokedAt               DateTime?
  revokedByUserId         String?
  revocationReason        String?
  rotatedFromId           String?                @unique
  overlapEndsAt           DateTime?
  createdByUserId         String
  version                 Int                    @default(1)
  issuanceRequestId       String                 @unique
  createdAt               DateTime               @default(now())
  updatedAt               DateTime               @updatedAt
  createdBy               User                   @relation("ApiCredentialCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  revokedBy               User?                  @relation("ApiCredentialRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)
  rotatedFrom             ApiCredential?         @relation("ApiCredentialRotation", fields: [rotatedFromId], references: [id], onDelete: Restrict)
  replacement             ApiCredential?         @relation("ApiCredentialRotation")
  scopes                  ApiCredentialScope[]
  projects                ApiCredentialProject[]
  events                  ApiCredentialEvent[]
  requestLogs             ApiRequestLog[]
  usageBuckets            ApiUsageBucket[]

  @@index([revokedAt, expiresAt])
  @@index([createdByUserId])
  @@index([lastUsedAt])
  @@index([name])
  @@index([recipientName])
}

model ApiCredentialScope {
  id              String        @id @default(cuid())
  credentialId    String
  scopeCode       String
  grantedAt       DateTime      @default(now())
  grantedByUserId String
  revokedAt       DateTime?
  revokedByUserId String?
  credential      ApiCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  grantedBy       User          @relation("ApiCredentialScopeGrantedBy", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  revokedBy       User?         @relation("ApiCredentialScopeRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@unique([credentialId, scopeCode])
  @@index([credentialId, revokedAt])
  @@index([scopeCode, revokedAt])
}

model ApiCredentialProject {
  id              String        @id @default(cuid())
  credentialId    String
  projectId       String
  grantedAt       DateTime      @default(now())
  grantedByUserId String
  revokedAt       DateTime?
  revokedByUserId String?
  credential      ApiCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  project         Project       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  grantedBy       User          @relation("ApiCredentialProjectGrantedBy", fields: [grantedByUserId], references: [id], onDelete: Restrict)
  revokedBy       User?         @relation("ApiCredentialProjectRevokedBy", fields: [revokedByUserId], references: [id], onDelete: SetNull)

  @@unique([credentialId, projectId])
  @@index([credentialId, revokedAt])
  @@index([projectId, revokedAt])
}

model ApiCredentialEvent {
  id             String                 @id @default(cuid())
  credentialId   String
  actorUserId    String?
  type           ApiCredentialEventType
  reason         String?
  summary        Json                   @default("{}")
  requestId      String?                @unique
  actorIp        String?
  actorUserAgent String?
  createdAt      DateTime               @default(now())
  credential     ApiCredential          @relation(fields: [credentialId], references: [id], onDelete: Cascade)
  actor          User?                  @relation("ApiCredentialEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)

  @@index([credentialId, createdAt])
  @@index([type, createdAt])
}

model ApiRequestLog {
  id            String        @id @default(cuid())
  credentialId  String
  requestId     String        @unique
  operationId   String
  scopeCode     String
  pathTemplate  String
  statusCode    Int
  outcomeCode   String
  responseRows  Int           @default(0)
  responseBytes Int           @default(0)
  durationMs    Int
  clientIp      String?
  userAgent     String?
  filterSummary Json          @default("{}")
  createdAt     DateTime      @default(now())
  credential    ApiCredential @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@index([credentialId, createdAt])
  @@index([operationId, createdAt])
  @@index([statusCode, createdAt])
  @@index([createdAt])
}

model ApiUsageBucket {
  id           String             @id @default(cuid())
  credentialId String
  windowKind   ApiUsageWindowKind
  windowStart  DateTime
  requests     Int                @default(0)
  rows         Int                @default(0)
  bytes        BigInt             @default(0)
  updatedAt    DateTime           @updatedAt
  credential   ApiCredential      @relation(fields: [credentialId], references: [id], onDelete: Cascade)

  @@unique([credentialId, windowKind, windowStart])
  @@index([windowKind, windowStart])
  @@index([updatedAt])
}

model QualityEvidence {
  id          String              @id @default(cuid())
  recordId    String
  kind        QualityEvidenceKind
  label       String?
  url         String?
  fileName    String?
  mimeType    String?
  storagePath String?
  publicToken String?             @unique
  position    Int                 @default(0)
  createdAt   DateTime            @default(now())
  record      QualityRecord       @relation(fields: [recordId], references: [id], onDelete: Cascade)

  @@index([recordId, position])
  @@index([kind])
  @@index([storagePath])
}

model QualityRecordSeq {
  type    QualityRecordType
  year    Int
  lastSeq Int               @default(0)

  @@id([type, year])
}

model NotificationPreferenceToken {
  id        String    @id @default(cuid())
  tokenHash String    @unique
  userId    String
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, usedAt, expiresAt])
  @@index([expiresAt])
}

model EpiCatalogItem {
  id        String      @id @default(cuid())
  name      String
  ca        String
  isActive  Boolean     @default(true)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  records   EpiRecord[]

  @@unique([name, ca])
  @@index([isActive])
  @@index([name])
}

model EpiRecord {
  id                    String               @id @default(cuid())
  collaboratorId        String
  catalogItemId         String?
  epiName               String
  ca                    String
  quantity              Int                  @default(1)
  lendDate              DateTime
  devolutionDate        DateTime?
  signatureRequestId    String?
  signatureImageDataUrl String?
  signatureSignerName   String?
  signedAt              DateTime?
  pendingReturn         Boolean              @default(false)
  returnSourceRecordId  String?
  archivedAt            DateTime?
  createdByUserId       String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  collaborator          Collaborator         @relation(fields: [collaboratorId], references: [id], onDelete: Restrict)
  catalogItem           EpiCatalogItem?      @relation(fields: [catalogItemId], references: [id], onDelete: SetNull)
  signatureRequest      EpiSignatureRequest? @relation(fields: [signatureRequestId], references: [id], onDelete: SetNull)
  createdBy             User?                @relation("EpiRecordCreator", fields: [createdByUserId], references: [id], onDelete: SetNull)

  @@index([collaboratorId])
  @@index([catalogItemId])
  @@index([signatureRequestId])
  @@index([signedAt])
  @@index([pendingReturn])
  @@index([returnSourceRecordId])
  @@index([archivedAt])
  @@index([collaboratorId, lendDate, createdAt])
}

model EpiSignatureRequest {
  id                      String                        @id @default(cuid())
  collaboratorId          String
  requestedByUserId       String?
  jobRoleIdSnapshot       String?
  roleNameSnapshot        String
  roleSourceSnapshot      EpiRoleSource
  tokenHash               String                        @unique
  status                  String                        @default("PENDING")
  expiresAt               DateTime
  signedAt                DateTime?
  signatureImageDataUrl   String?
  signatureSignerName     String?
  signedPdfPath           String?
  signedPdfHash           String?
  signedPdfFileName       String?
  ipAddress               String?
  userAgent               String?
  privacyNoticeAcceptedAt DateTime?
  privacyNoticeVersion    String?
  createdAt               DateTime                      @default(now())
  updatedAt               DateTime                      @updatedAt
  collaborator            Collaborator                  @relation(fields: [collaboratorId], references: [id], onDelete: Restrict)
  requestedBy             User?                         @relation("EpiSignatureRequester", fields: [requestedByUserId], references: [id], onDelete: SetNull)
  jobRoleSnapshot         JobRole?                      @relation("EpiSignatureJobRoleSnapshot", fields: [jobRoleIdSnapshot], references: [id], onDelete: Restrict)
  records                 EpiRecord[]
  auditLogs               EpiSignatureRequestAuditLog[]

  @@index([collaboratorId])
