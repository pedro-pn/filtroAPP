  order             Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jobRole           JobRole? @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([jobRoleId])
}

// Previsão de hora extra vendida: por cargo e total de horas previstas.
model ProjectPlannedOvertime {
  id                String   @id @default(cuid())
  projectId         String
  jobRoleId         String?
  roleName          String? // rótulo do cargo (snapshot/fallback quando sem jobRoleId)
  collaboratorCount Int      @default(1) // legado: horas previstas já são totais, não por colaborador
  hours             Decimal  @default(0) @db.Decimal(10, 2)
  note              String?
  order             Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  jobRole           JobRole? @relation(fields: [jobRoleId], references: [id], onDelete: SetNull)

  @@index([projectId])
  @@index([jobRoleId])
}

// === Integração Omie (compras realizadas por projeto) ===

// Cache dos projetos do Omie (codigo interno -> nº da OS/missão extraído do nome).
model OmieProject {
