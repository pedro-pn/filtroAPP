// Unidade de medida do quantitativo previsto de serviços (escopo vendido).
// Em uso hoje: M (tubulação) e L (óleo) — as que casam com o realizado do RDO. KG/T/UN ficam
// reservadas para quando o RDO passar a capturar peso/tanques (sem fonte de realizado por ora).
enum PlannedMeasureUnit {
  M // metros (tubulação)
  KG // quilos (reservado)
  T // toneladas (reservado)
  UN // unidades (reservado)
  L // litros (óleo)
}

