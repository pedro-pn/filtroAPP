// === Importação do banco comercial Access (propostas_bd.accdb) ===

// Staging 1:1 da tabela `proposta` do Access (uma linha por revisão de proposta).
model CommercialProposal {
  id                   String           @id @default(cuid())
  codBd                Int              @unique // cod_bd (PK do Access) — chave de idempotência
  codProp              Int // cod_prop (nº da proposta)
  parentCodProp        Int? // cod_proposta_mae/cod_prop_mae: proposta principal quando esta linha é adicional
  nRev                 Int              @default(0) // n_rev (revisão)
  codNectar            Int? // cod_nectar (código externo CRM)
  proposalDate         DateTime? // data_proposta
  createdInAccessAt    DateTime? // dataCriacao
  modifiedInAccessAt   DateTime? // dataMod
  clientName           String? // nome_cliente
  clientCnpj           String? // n_cnpj (como string)
  contactName          String? // contato_cliente
  contactEmail         String? // email_cliente
  localObra            String? // local_obra
  sede                 String? // sede
  elaborador           String? // elaborador_proposta
  vendedor             String? // nome_vendedor
  serviceModality      ServiceModality? // derivado: INLOCO vs POP_SEDE
  salePrice            Decimal?         @db.Decimal(14, 2) // valor_inloco | valor_pop_sede
  plannedCost          Decimal?         @db.Decimal(14, 2) // valor_custos
  expectedProfit       Decimal?         @db.Decimal(14, 2) // valor_lucro
  expectedMargin       Decimal?         @db.Decimal(6, 2) // margem_inloco | margem_pop_sede (%)
  taxes                Decimal?         @db.Decimal(14, 2) // valor_imp
  plannedDays          Int? // n_dias (corridos)
  workedDays           Int? // n_dias_trabalhados
  mobilizationLeadDays Int? // prev_atende (dias p/ iniciar mobilização após aprovação)
  numOperators         Int? // n_operadores
  numSupervisors       Int? // n_encarregado
  numPerDay            Int? // n_p_dia
  numPerNight          Int? // n_p_noite
  isComplete           Boolean          @default(false) // false quando sem valor de venda
  components           Json             @default("{}") // componentes de custo/preço normalizados (HE, standby, diárias, mobilização...)
  rawRow               Json // linha original completa (à prova de futuro)
  lastImportId         String?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt

  @@index([codProp, nRev])
  @@index([parentCodProp, codProp, nRev])
  @@index([clientCnpj])
  @@index([lastImportId])
}

// Log de cada importação do banco Access.
model AccessImport {
  id                     String             @id @default(cuid())
  fileName               String
  contentHash            String
  source                 AccessImportSource @default(SCRIPT)
  status                 AccessImportStatus @default(SUCCESS)
  rowsRead               Int                @default(0)
  created                Int                @default(0)
  updated                Int                @default(0)
  skipped                Int                @default(0)
  pendingProjectsCreated Int                @default(0)
  error                  String?
  summary                Json?
  importedByUserId       String?
  importedBy             User?              @relation("AccessImportUser", fields: [importedByUserId], references: [id], onDelete: SetNull)
  createdAt              DateTime           @default(now())

  @@index([status, createdAt])
  @@index([contentHash])
  @@index([createdAt])
}

// Orçamento previsto derivado da proposta vigente (maior revisão por cod_prop).
model ProjectBudget {
  id                   String                @id @default(cuid())
  projectId            String
  version              Int                   @default(1)
  sourceProposalCodBd  Int?
  serviceModality      ServiceModality?
  salePrice            Decimal?              @db.Decimal(14, 2)
  plannedTotalCost     Decimal?              @db.Decimal(14, 2)
  expectedProfit       Decimal?              @db.Decimal(14, 2)
  expectedMargin       Decimal?              @db.Decimal(6, 2)
  taxes                Decimal?              @db.Decimal(14, 2)
  plannedDays          Int?
  selectionStatus      BudgetSelectionStatus @default(UNKNOWN)
  selectedByUserId     String?
  selectedBy           User?                 @relation("ProjectBudgetSelectedBy", fields: [selectedByUserId], references: [id], onDelete: SetNull)
  selectedAt           DateTime?
  approvedAt           DateTime? // data de aprovação do contrato (default = momento da seleção; editável)
  mobilizationLeadDays Int? // prev_atende: dias após aprovação p/ iniciar mobilização
  isComplete           Boolean               @default(false)
  source               String                @default("ACCESS_IMPORT")
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  project              Project               @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([projectId, version])
  @@index([projectId])
  @@index([sourceProposalCodBd])
  @@index([selectionStatus])
}

// Revisão de proposta adicional selecionada para compor o orçamento previsto de um projeto.
// Uma proposta adicional pode ter várias revisões; para cada codProp adicional guardamos só a revisão vigente.
model ProjectAdditionalProposal {
  id                  String   @id @default(cuid())
  projectId           String
  codProp             Int
  sourceProposalCodBd Int
  selectedByUserId    String?
  selectedAt          DateTime @default(now())
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  selectedBy          User?    @relation("ProjectAdditionalProposalSelectedBy", fields: [selectedByUserId], references: [id], onDelete: SetNull)

  @@unique([projectId, codProp])
  @@index([projectId])
  @@index([sourceProposalCodBd])
  @@index([selectedByUserId])
}

// Serviço vendido (escopo) previsto. Hoje é preenchido manualmente no cronograma — idealmente viria
// do banco comercial, que ainda não carrega esses campos. Cada serviço agrupa um ou mais "sistemas"
// (tubulações em m, óleo em L), cada um com seu quantitativo — alinhado ao que o RDO registra como
// realizado, para entrar no cálculo de avanço.
model ProjectPlannedService {
  id          String                        @id @default(cuid())
  projectId   String
  serviceType String // LIMPEZA_QUIMICA | TESTE_PRESSAO | FLUSHING | FILTRAGEM | (livre)
  weight      Decimal                       @default(1) @db.Decimal(6, 2) // peso do serviço no avanço do projeto (D-3)
  note        String?
  order       Int                           @default(0)
  createdAt   DateTime                      @default(now())
  updatedAt   DateTime                      @updatedAt
  project     Project                       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  systems     ProjectPlannedServiceSystem[]

  @@index([projectId])
}

// Sistema/quantitativo de um serviço previsto: tubulações (m) ou óleo (L).
model ProjectPlannedServiceSystem {
  id           String                @id @default(cuid())
  serviceId    String
  systemType   String // TUBULACAO | OLEO
  description  String?
  diameter     String?
  diameterUnit String?
  quantity     Decimal?              @db.Decimal(14, 2)
  unit         PlannedMeasureUnit? // unidade do sistema (TUBULACAO=M, OLEO=L)
  order        Int                   @default(0)
  service      ProjectPlannedService @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@index([serviceId])
}

// Previsão de horas normais vendidas: por cargo e total de horas previstas.
model ProjectPlannedNormalHours {
  id                String   @id @default(cuid())
  projectId         String
  jobRoleId         String?
  roleName          String? // rótulo do cargo (snapshot/fallback quando sem jobRoleId)
