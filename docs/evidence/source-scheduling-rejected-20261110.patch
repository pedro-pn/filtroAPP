diff --git a/backend/src/lib/operations/read-sources.js b/backend/src/lib/operations/read-sources.js
new file mode 100644
index 00000000..deb82d2e
--- /dev/null
+++ b/backend/src/lib/operations/read-sources.js
@@ -0,0 +1,21 @@
+import { performance } from 'node:perf_hooks';
+import { measureRequestStage, recordRequestStageDuration } from './request-performance.js';
+
+// Limit independent source groups, not connections or queries. Each source may
+// use its existing relation queries. Queueing acquires/reserves no database
+// connection. Every admitted source's queue time is observable.
+export async function loadReadSources(sources, { concurrency = 3, stage = 'read.sources' } = {}) {
+  if (!Number.isInteger(concurrency) || concurrency < 1) throw new RangeError('Invalid source concurrency');
+  const results = new Array(sources.length), queuedAt = performance.now();
+  let next = 0, failure;
+  await Promise.all(Array.from({ length: Math.min(concurrency, sources.length) }, async () => {
+    while (!failure && next < sources.length) {
+      const index = next++;
+      recordRequestStageDuration(stage + '.queue', performance.now() - queuedAt);
+      try { results[index] = await measureRequestStage(stage + '.run', sources[index]); }
+      catch (error) { failure ??= { error }; }
+    }
+  }));
+  if (failure) throw failure.error;
+  return results;
+}
diff --git a/backend/test/read-sources.test.js b/backend/test/read-sources.test.js
new file mode 100644
index 00000000..720964e4
--- /dev/null
+++ b/backend/test/read-sources.test.js
@@ -0,0 +1,48 @@
+import assert from 'node:assert/strict';
+import test from 'node:test';
+import { setImmediate } from 'node:timers/promises';
+import { loadReadSources } from '../src/lib/operations/read-sources.js';
+import { withRequestPerformance } from '../src/lib/operations/request-performance.js';
+
+test('lazy read sources obey the budget, retain result order and record queue time inside the request', async () => {
+  let active = 0, peak = 0;
+  const trace = { stages: {} };
+  const result = await withRequestPerformance(trace, () => loadReadSources(Array.from({ length: 9 }, (_, index) => async () => {
+    active++; peak = Math.max(peak, active);
+    await setImmediate();
+    active--;
+    return { id: 'private-' + index };
+  }), { concurrency: 3, stage: 'detail.sources' }));
+  assert.equal(peak, 3);
+  assert.deepEqual(result.map(row => row.id), Array.from({ length: 9 }, (_, index) => 'private-' + index));
+  assert.ok(trace.stages['detail.sources.queue'] > 0);
+  assert.ok(trace.stages['detail.sources.run'] > 0);
+  assert.deepEqual(Object.keys(trace.stages).sort(), ['detail.sources.queue', 'detail.sources.run']);
+  assert.doesNotMatch(JSON.stringify(trace), /private-/);
+});
+
+test('failed reads stop admission and drain already admitted sources before rejecting', async () => {
+  let release, completed = false;
+  const started = [], failure = new Error('read failed'), gate = new Promise(resolve => { release = resolve; });
+  const pending = loadReadSources([
+    async () => { started.push(0); throw failure; },
+    async () => { started.push(1); await gate; },
+    () => { started.push(2); }
+  ], { concurrency: 2 }).catch(error => { completed = true; return error; });
+  await setImmediate();
+  assert.deepEqual(started, [0, 1]);
+  assert.equal(completed, false);
+  release();
+  assert.equal(await pending, failure);
+  assert.deepEqual(started, [0, 1]);
+});
+
+test('source budgets belong to the calculation and do not serialize other requests', async () => {
+  let active = 0, peak = 0;
+  const source = async () => { active++; peak = Math.max(peak, active); await setImmediate(); active--; };
+  await Promise.all([loadReadSources([source, source], { concurrency: 2 }), loadReadSources([source, source], { concurrency: 2 })]);
+  assert.equal(peak, 4);
+  assert.deepEqual(await loadReadSources([]), []);
+  assert.deepEqual(await loadReadSources([() => null, () => false, () => 0]), [null, false, 0]);
+  for (const concurrency of [0, -1, 1.5]) await assert.rejects(loadReadSources([], { concurrency }), RangeError);
+});
