# Copie para deploy/logs/.env no servidor (fora do git) e preencha.
# Os três valores vêm do comando de instalação que o Grafana Cloud mostra
# (Connections > Add new connection > Hosted logs, ou o "Install Alloy").
# Não rode aquele comando: ele instala o agente direto no host.

# GCLOUD_HOSTED_LOGS_URL do comando. Deve terminar em /loki/api/v1/push.
GRAFANA_LOGS_URL=https://logs-prod-000.grafana.net/loki/api/v1/push
# GCLOUD_HOSTED_LOGS_ID do comando (número).
GRAFANA_LOGS_USER=000000
# GCLOUD_RW_API_KEY do comando (começa com glc_).
GRAFANA_LOGS_TOKEN=
# Rótulo "host" nas buscas.
LOGS_HOST=vps-filtrovali
